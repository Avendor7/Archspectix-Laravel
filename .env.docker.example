APP_IMAGE=registry.avendor.ca/stephen/archspectix-laravel:COMMIT_SHA
APP_NAME=Archspectix
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://archspectix.example.com
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=archspectix
DB_USERNAME=archspectix
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

NIGHTWATCH_ENABLED=false
